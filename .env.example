# Полный список настроек — для нашего стенда с Caddy и сине-зелёной выкаткой.
#
# Ставите бота на сервер МБК? Вам нужен другой файл: deploy/prod/env.example.
# Он короче, в нём заполняются пять значений, а остальное уже настроено.
# Инструкция — docs/INSTALL.md.

MBK_LLM_PROVIDER=polza
POLZA_API_KEY=
# Для отката выберите openrouter и задайте OPEN_ROUTER_API_KEY.
# OPEN_ROUTER_API_KEY=

# Разговорная модель (её слышит клиент). Бери БЫСТРУЮ чат-модель, не reasoning.
# Рекомендации для «как GPT» + русский + стриминг (проверь точные слаги на polza.ai/models
# и сравни через run_eval.py gen --model ...):
#   google/gemini-3-flash       — быстрый, отличный русский, хороший баланс цена/живость
#   qwen/qwen3.6-plus           — рядом по качеству, дешевле, надёжный
#   anthropic/claude-opus-4.7   — теплее/естественнее, дороже (как якорь качества)
POLZA_MODEL=qwen/qwen3.7-max

# Молчаливый извлекатель JSON (клиент не видит). Можно дешевле основной. Пусто = та же модель.
POLZA_EXTRACTOR_MODEL=deepseek/deepseek-v4-pro

# Optional model for the combined C validator only; empty keeps EXTRACTOR_MODEL.
# Extraction E, factual source audit F and Nika's G model are unchanged.
POLZA_POLICY_SEMANTIC_MODEL=

# Кэш статического префикса. 1=вкл (по умолчанию), 0=выкл.
OPENROUTER_PROMPT_CACHE=1

OPENROUTER_TEMPERATURE=0.75
OPENROUTER_MAX_TOKENS=5000

# === Подключение к Polza.ai ===
# MBK_LLM_PROVIDER=polza выбирает https://polza.ai/api/v1 и прямое соединение.
# В этом режиме старые OPENROUTER_PROXY, HTTP_PROXY и HTTPS_PROXY не используются.
# Общие параметры ниже сохраняют исторические имена OPENROUTER_*.
# Для OpenRouter выберите MBK_LLM_PROVIDER=openrouter и задайте его отдельный ключ.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Таймаут запроса к модели, сек. Через прокси/зарубежный VPS поднимите при необходимости.
OPENROUTER_TIMEOUT=120
# Как OpenRouter выбирает провайдера модели. latency — самый отзывчивый:
# одна и та же модель у разных провайдеров отвечает то за 3, то за 12 секунд.
# off — не вмешиваться (например, если шлюз не пропускает поле provider).
OPENROUTER_PROVIDER_SORT=latency

# === Интерпретация разговорных фактов ===
# semantic — typed extractor + deterministic reducer; при ошибке хода fallback
# на legacy. Этот режим прошёл fact-eval 50/50 + holdout 14/14 и dialog 12/12.
# legacy — старый extractor без дополнительного semantic-вызова.
# shadow — параллельно запускает новый semantic extractor, но НЕ применяет его
# результат к вопросам, маршруту или CRM. Сравнение видно в state.interpretation.
MBK_FACT_INTERPRETATION_MODE=semantic
# Пусто = модель по умолчанию из config.py (deepseek/deepseek-v4.1-flash).
MBK_FACT_INTERPRETATION_MODEL=
# Жёсткий лимит дополнительных OpenRouter-вызовов на одну локальную сессию.
MBK_FACT_SHADOW_MAX_CALLS_PER_SESSION=5
# Один shadow-вызов не делает retry и ограничен коротким JSON.
MBK_FACT_SHADOW_MAX_TOKENS=1000
MBK_FACT_SHADOW_TIMEOUT=30

# === Маскировка персональных данных (ФЗ-152) ===
# 1=вкл (по умолчанию). В зарубежные LLM уходит обезличенная копия: ФИО→только имя,
# телефон скрыт, дата рождения→только год, адрес→только город. Финансовые суммы и
# параметры авто/недвижимости сохраняются (без них бот не работает). Оригинал ПД
# остаётся на этом сервере (для выгрузки лида в CRM).
# ВАЖНО: маскировка покрывает данные из анкеты и типовые телефоны/даты в свободном тексте.
# НЕ покрывает: если клиент сам впишет адрес/документ в свободной форме — это остаточный
# риск, отмеченный к проработке на следующем этапе.
ENABLE_PII_MASKING=1

# Публичные порты Caddy. Для production нужны 80/443; ниже безопасные локальные значения.
MBK_PORT=8501
MBK_HTTPS_PORT=8443
# Порт чата на петле для стека передачи (deploy/prod). Наружу не публикуется:
# трафик приводит nginx заказчика.
MBK_HTTP_PORT=8080

# === База ===
# Пароль пользователя приложения. Требуется обоими стеками — и нашим edge, и
# стеком передачи. Задаётся ДО первого запуска: база инициализируется один раз.
MBK_PG_PASSWORD=
MBK_PG_USER=mbk_app
MBK_PG_DB=mbk

# === Observability (Langfuse) — необязательно ===
# Если ключи не заданы — приложение работает как раньше, ничего никуда не уходит.
# Включает дашборд по каждому ходу диалога: промпт, ответ, латентность, токены, стоимость.
# Внимание: трейс содержит факты клиента в виде, в котором они ушли в модель. Если PII
# критичен — поднимай self-hosted Langfuse или включай LANGFUSE_DISABLED=true.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_DISABLED=true   # быстро отключить трейсинг, не убирая ключи

# Static login screen for web UI. Required in runtime .env.
MBK_AUTH_USERNAME=
MBK_AUTH_PASSWORD=
# Для HTTPS production обязательно 1; для обычного локального HTTP оставить 0.
MBK_AUTH_COOKIE_SECURE=0

# --- v4: маршрутизирующий микросервис ---
# MBK_ROUTER_URL   — endpoint сервиса маршрутизации. Пустое значение больше НЕ включает мок.
# MBK_ROUTER_TOKEN — Bearer-токен, если сервис его требует.
# MBK_ROUTER_MOCK  — шаблон безопасен для локального запуска. В production
# установить 0 и задать MBK_ROUTER_URL.
MBK_ROUTER_URL=
MBK_ROUTER_TOKEN=
MBK_ROUTER_MOCK=1
MBK_ROUTER_TIMEOUT=20
MBK_ROUTER_MAX_ATTEMPTS=2
# Необязательно: allowlist доменов ссылок в ответе, через запятую.
MBK_ROUTER_ALLOWED_HOSTS=

# === Боевой classification API CRM МБК ===
# Две qualification-операции не создают лид. Endpoint lead-intake заблокирован,
# пока флаг ниже явно не включён.
MBK_CRM_BASE_URL=https://crm.mbk.ru/lara/api/classification
MBK_CRM_TIMEOUT=20
MBK_CRM_CLASSIFICATION_MAX_ATTEMPTS=2
# ВНИМАНИЕ: 1 разрешает создавать реальные лиды. Автоматических retry нет,
# поскольку backend пока не подтвердил idempotency key.
MBK_CRM_LEAD_INTAKE_ENABLED=0
# 1 подключает цепочку qualification → consent → lead-intake к живому диалогу.
# При 0 локальный UI продолжает работать через диагностический mock JSON.
MBK_CRM_WORKFLOW_ENABLED=0
# Дополнительный fail-closed gate. Для текущего боевого smoke использовать test:
# тогда разрешено только ФИО «Тестов Тест Тестович» и номер из allowlist.
# Значение production снимает тестовое ограничение и допустимо только на платформе.
MBK_CRM_SUBMISSION_MODE=production
MBK_CRM_TEST_PHONE_ALLOWLIST=
# Частичные лиды: включать только вместе с lead-intake после проверки production.
MBK_CRM_ABANDONED_LEADS_ENABLED=0
# Спросить про второй объект недвижимости, если первый под залог не проходит.
# Добывает залоговых клиентов, но удлиняет анкету тем, у кого сработала.
MBK_CRM_SECOND_REALTY_ENABLED=0
MBK_CRM_ABANDONED_INACTIVITY_SECONDS=900

# Спрашивать ли согласие на консультацию партнёра репликой в чате.
# По умолчанию 0: согласие человек даёт на офер-странице, куда переходит по
# ссылке, а в CRM уходит 23002 «шаг не показывался». 1 возвращает прежнее
# поведение — бот спрашивает сам и отправляет 23000/23001 по ответу.
MBK_ASK_SITE_CONSENT_IN_CHAT=0

# === Согласие с офер-страницы ===
# Включает ожидание согласия с офер-страницы. ВКЛЮЧАТЬ ТОЛЬКО КОГДА на
# офер-страницах появится кнопка согласия (см. docs/SITE_CONSENT_BUTTON.md).
# Пока её нет, ожидание вредит: лид уйдёт на 15 минут позже и с отметкой
# «отказался», хотя клиенту нечего было нажимать.
MBK_SITE_CONSENT_PAUSE_ENABLED=0
# Необязательное ограничение по адресу отправителя согласия. Пусто — принимаем
# откуда угодно (значение по умолчанию): внутри контейнеров адрес не постоянен,
# к нам приходит шлюз docker-сети, и он меняется при пересоздании стека.
#
# Если однажды адрес станет постоянным, впишите его сюда — какой именно, видно
# в логе: принятое согласие пишется строкой «Согласие с сайта принято: сессия
# X, статус Y, адрес Z».
MBK_SITE_CONSENT_ALLOWED_IPS=
# Сколько ждём нажатия кнопки. Не дождались — лид уходит без согласия, и
# роутер уводит его в колл-центр. Значение заказчика: 15 минут.
MBK_SITE_CONSENT_TIMEOUT_SECONDS=900
# Как часто проверяем истёкшие ожидания.
MBK_SITE_CONSENT_SCAN_SECONDS=30
# Адрес на стороне заказчика, который дописывается в офер-ссылку параметром
# url= — его зовёт страница после нажатия кнопки.
MBK_SITE_CONSENT_CALLBACK_URL=https://www.mbk.ru/api/chat-consent
# Офер-страница на случай, когда CRM своей не вернула: у маршрутов БФЛ ссылки
# в матрице нет, а кнопка согласия живёт на постоянной странице. Этот адрес
# уходит клиенту как есть, без параметров: страница узнаёт его по куке, которую
# ставит виджет. Пусто — такой лид уходит сразу, без ожидания.
MBK_SITE_CONSENT_DEFAULT_URL=
# Страницы, на которых кнопка согласия действительно есть. Пауза включается
# только для них: сайт узнаёт клиента по куке своего домена, поэтому офер на
# другом хосте (info.mbk.ru у залоговых маршрутов) кнопку не покажет, и
# ожидание закончилось бы отметкой «отказался». Пусто — не ограничиваем.
MBK_SITE_CONSENT_BUTTON_PAGES=
# Страница подтверждения по категории. Дефолт зашит в коде
# (DEFAULT_SITE_CONSENT_OFFER_PAGES в crm_dialog_workflow.py):
#   3895=https://www.mbk.ru/bfl-finish,21300=https://www.mbk.ru/bfl-finish
# Матрица хранит только «URL спасибо» — страницу ПОСЛЕ согласия; адрес самой
# страницы с кнопкой задаёт эта карта. Для категории без записи берётся
# ссылка из матрицы, затем MBK_SITE_CONSENT_DEFAULT_URL.
#
# Переназначить: перечислить ВСЮ карту заново парами «категория=адрес» через
# запятую — значение переменной полностью заменяет дефолт, а не дополняет его:
#   MBK_SITE_CONSENT_OFFER_PAGES=3895=https://www.mbk.ru/bfl-finish,21300=https://www.mbk.ru/bfl-finish,4705=https://info.mbk.ru/offer-auto
# Выключить карту совсем: MBK_SITE_CONSENT_OFFER_PAGES=off
# Не забыть: страницу на стороннем домене нужно добавить и в
# MBK_SITE_CONSENT_BUTTON_PAGES, иначе пауза для неё не включится.
MBK_SITE_CONSENT_OFFER_PAGES=

# === Развилка на входе ===
# Первая реплика клиента делится на «деньги», «уже оставлял заявку» и «не наш
# профиль». В двух последних ветках анкета не начинается и лид не создаётся.
# Включено по умолчанию; 0 — поведение без развилки целиком.
MBK_ENTRY_ROUTING=1

# Чипсы в приветствии: кнопки «Получить деньги» и «Другой вопрос» под первой
# репликой бота. Работают только вместе с развилкой. Включено по умолчанию;
# 0 — без кнопок.
MBK_QUICK_REPLIES=1

MBK_CRM_ABANDONED_SCAN_SECONDS=30

# === DaData / ФИАС: нормализация региона и одноимённых городов ===
# Серверный API-ключ Suggestions. В браузер ключ не передаётся.
MBK_DADATA_API=
MBK_DADATA_TIMEOUT=5
# По умолчанию один внешний запрос: retry тоже расходует квоту.
MBK_DADATA_MAX_ATTEMPTS=1
# Малый локальный предохранитель: потолок обращений за сутки. Для production
# задать осознанный лимит; 0 полностью запрещает внешние запросы.
MBK_DADATA_REQUEST_BUDGET=8
# Обычно endpoint менять не нужно.
MBK_DADATA_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs/suggest/address

# === Доступ клиента ===
# 0 — чат закрыт логином из MBK_AUTH_* (наш стенд). 1 — открыт: клиент приходит
# по кнопке с сайта МБК и пароля не знает. Умолчание закрытое намеренно.
MBK_PUBLIC_CHAT=1
# Потолок разговоров с одного адреса в час. Открытый чат — открытый расход на
# модель: диалог стоит около 3,3 ₽ и без потолка крутится в цикле.
MBK_PUBLIC_CHAT_SESSIONS_PER_HOUR=10
# Сколько прокси стоит перед приложением. Адрес посетителя берётся из
# X-Forwarded-For СПРАВА: левые звенья присылает сам клиент и подделывает свободно.
# Звеньев два в обеих схемах: у нас Caddy → nginx фронтенда, у МБК их nginx →
# наш nginx. Здесь стояла единица — и бот принимал за адрес посетителя адрес
# собственного nginx: всех под одним адресом, а после десяти диалогов лимит
# закрывает чат сразу всем. Как проверить своё число — docs/INSTALL.md, шаг 5.
MBK_TRUSTED_PROXY_HOPS=2
# Потолок длины одной реплики. Живой человек столько не пишет, а в промпт
# уезжает всё.
MBK_MAX_MESSAGE_CHARS=2000

# === Ассистент ===
# Имя и пол собеседника. Пол меняет не только приветствие: по-русски бот
# говорит о себе глаголами прошедшего времени («поняла» / «понял»), и
# смешивать род с именем нельзя. Допустимые значения пола: female, male.
MBK_ASSISTANT_NAME=Ника
MBK_ASSISTANT_GENDER=female

# === Переписка в базе ===
# Диалоги целиком складываются в таблицу dialog_messages той же базы, что и
# аналитика: читать их можно обычным SELECT (пример запроса — в комментарии к
# analytics/migrations/003_dialog_messages.sql). Пустое или 0 выключает запись.
MBK_DIALOG_TRANSCRIPTS_ENABLED=1
# Соль отпечатка телефона. Номер в таблицу не попадает: вместо него пишется
# «[телефон a1b2c3d4e5f6]». Без соли отпечаток равен открытому номеру —
# российских номеров порядка миллиарда, и голый хэш перебирается за минуты.
# Значение — любая длинная случайная строка; менять её нельзя, иначе
# отпечатки старых диалогов перестанут совпадать с новыми.
MBK_DIALOG_PHONE_SALT=
# Сколько дней хранить переписку. Пусто или 0 — хранить бессрочно: это
# решение владельца базы, а не бота. Чистка идёт тем же часовым обходом, что
# и срок хранения сессий.
MBK_DIALOG_RETENTION_DAYS=

# Сколько живёт cookie операторского входа.
MBK_AUTH_TTL_SECONDS=43200
# Домены, которым разрешён кросс-доменный вызов API. Пусто — только свой origin.
# Звёздочка вместе с cookie браузерами не принимается, поэтому нужен точный адрес.
CORS_ALLOWED_ORIGINS=

# === Панель разбора ===
# Итоговый JSON, номер лида, режим отправки и расход токенов. Живёт в том же
# интерфейсе, что и чат клиента, поэтому по умолчанию скрыта.
MBK_DEBUG_PANEL=0

# === Хранилища ===
# Аналитика событий. Без DSN recorder выключен, приложение работает как раньше.
MBK_ANALYTICS_DSN=
# Состояние диалогов. Без DSN сессии живут только в памяти и рестарт их стирает —
# вместе со статусом отправки лида, то есть с гарантией «лид уходит один раз».
# Переменная отдельная: включение аналитики не должно молча включать хранение ПД.
MBK_SESSIONS_DSN=
# Срок хранения сессии вместе с персональными данными.
MBK_SESSION_RETENTION_HOURS=72
MBK_SESSION_RETENTION_SCAN_SECONDS=3600

# === Прочее ===
OPENROUTER_API_KEY=
# Прокси только для вызовов модели, можно несколько через запятую (второй —
# запасной). HTTP_PROXY/HTTPS_PROXY читаются как запасной вариант настройки.
OPENROUTER_PROXY=
# 1 отключает отправку трасс в Langfuse.
LANGFUSE_DISABLED=
# Модель, играющая клиента в ролевом эвале. Намеренно не та, что ведёт разговор.
MBK_EVAL_CLIENT_MODEL=openai/gpt-5.4-mini
